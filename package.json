{
  "name": "braintwo",
  "version": "0.0.2",
  "description": "Personal knowledge base from your WhatsApp self-chat",
  "main": "out/main/main.mjs",
  "type": "module",
  "private": true,
  "author": "Syntropy",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/run-evite.mjs dev",
    "dev:demo": "BRAINTWO_DEMO=true node scripts/run-evite.mjs dev",
    "predev": "node scripts/rebuild-for-electron.mjs",
    "build": "node scripts/run-evite.mjs build",
    "prebuild": "node scripts/run-evite.mjs build",
    "preview": "node scripts/run-evite.mjs preview",
    "package": "node -e \"import('fs').then(fs => fs.rmSync('.abi', {recursive:true, force:true})).catch(()=>{})\" && npm run rebuild:electron && node scripts/run-evite.mjs build && electron-builder",
    "package:mac": "node -e \"import('fs').then(fs => fs.rmSync('.abi', {recursive:true, force:true})).catch(()=>{})\" && npm run rebuild:electron && node scripts/run-evite.mjs build && electron-builder --mac dmg",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "pretest": "node scripts/rebuild-for-node.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "node scripts/rebuild-for-node.mjs",
    "rebuild:electron": "node scripts/rebuild-for-electron.mjs",
    "rebuild:node": "node scripts/rebuild-for-node.mjs",
    "postinstall": "electron-builder install-app-deps && node scripts/rebuild-for-electron.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc10",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.10.0",
    "pino": "^10.3.1",
    "pino-std-serializers": "^7.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite-vec": "^0.1.9"
  }
}
